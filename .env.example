# ==============================================================================
# OpenFishTools Studio - Environment Configuration Template
# Salin file ini menjadi `.env` sebelum menjalankan deploy atau fitur backend.
# ==============================================================================

# Catbox Project Storage Userhash (opsional untuk hosting berkas aset cloud)
CATBOX_USERHASH=your_catbox_userhash

# Upload Secret Token (Melindungi endpoint /api/share dari upload tanpa izin)
SHARE_SECRET_TOKEN=your_secret_upload_token

# Cloudflare KV Namespace ID (untuk binding PROJECTS_KV pada wrangler.jsonc)
CF_KV_NAMESPACE_ID=your_kv_namespace_id
